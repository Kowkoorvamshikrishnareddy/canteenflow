# CanteenFlow Environment Configuration
# Copy this file to .env and adjust variables as needed

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & Session Security
JWT_SECRET=canteenflow_super_secret_jwt_key_2026
SESSION_SECRET=canteenflow_session_secret_key_2026

# Supabase PostgreSQL & Auth (Optional: runs in Development/Demo Sandbox mode if blank)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Integration (Optional: runs in Payment Simulator mode if blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
